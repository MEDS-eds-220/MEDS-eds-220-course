      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Prepare populated places points\n",
        "\n",
        "Let's now explore the populated places data. "
      ],
      "id": "4ff1cc6f"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "print(f\"CRS: {places.crs}\")\n",
        "\n",
        "places.head(3)"
      ],
