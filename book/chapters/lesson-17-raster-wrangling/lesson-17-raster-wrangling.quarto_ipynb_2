      "id": "d574a402"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "labels_from_item = pd.DataFrame({'code': [c['values'][0] for c in class_values],\n",
        "                                 'class_label': [c['summary'] for c in class_values]})\n",
        "labels_from_item"
